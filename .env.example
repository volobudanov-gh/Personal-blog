# .env.example
# Копируйте этот файл в .env.local и заполняйте свои значения
# НИКОГДА не коммитьте .env.local в Git!

# Supabase (публичные ключи - безопасно в браузере)
NEXT_PUBLIC_SUPABASE_URL=https://prIdmdadnotydwiodwti.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase (приватные ключи - только на сервере!)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Database (для миграций и админ-скриптов)
DATABASE_URL=postgresql://postgres:PASSWORD@prIdmdadnotydwiodwti.postgres.supabase.co:5432/postgres

# GitHub (для CI/CD)
GITHUB_TOKEN=your_github_token_here

# Приложение
ENVIRONMENT=development
# ENVIRONMENT=production (для Vercel)
